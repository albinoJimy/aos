# EditorConfig — AOS monorepo. Ver specs/01_Engineering_Standards_e_Handoff.md
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{tf,tfvars,hcl}]
indent_size = 2

[*.{go}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
