# --- Terraform / OpenTofu ---
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Backend/override files that may carry local endpoints/creds — NEVER commit
*.override.tf
*.override.tf.json
override.tf
override.tf.json
.terraform.lock.hcl.local
# tfvars podem conter segredos: só se versiona env/*.tfvars (sem segredos, revistos)
*.auto.tfvars
secrets.tfvars
*.secrets.tfvars

# --- Segredos / credenciais (nunca versionar — ADR-006) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
vault-token
.vault-token

# --- Node / TS ---
node_modules/
dist/
build/
*.tsbuildinfo

# --- Python ---
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/

# --- Go ---
bin/
vendor/
# Binários compilados de comandos (go build ./... em packages/cmd/*) — nunca versionar
*.exe
/packages/cmd/aos-demo/aos-demo
/packages/cmd/aos/aos
/packages/cmd/aos-issuer/aos-issuer
/packages/cmd/aos-attestation/aos-attestation
# Artefactos transitórios dos self-tests do CI (removidos pelo runner; rede de segurança)
packages/_selftest_bad/
# Perfis de cobertura (gerados por `go test -coverprofile`)
*.out
cover*.out
coverage.out
# Artefacto de cobertura máquina-legível (AOS-109): SÓ o directório na RAIZ do repo
# (COVERAGE_LCOV_OUT=$REPO_ROOT/coverage/lcov.info). Ancorado com "/" inicial para NÃO
# ignorar o pacote-fonte packages/testkit/coverage/ (o conversor cov2lcov).
/coverage/

# --- Ferramentas / IDE / SO ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
.claude/
