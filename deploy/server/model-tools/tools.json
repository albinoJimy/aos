[
  {
    "name": "doc_read",
    "description": "Lê um documento local por id. Usa isto quando te pedirem para ler ou consultar um documento.",
    "parameters": {
      "type": "object",
      "properties": {
        "doc_id": { "type": "string", "description": "id do documento a ler" }
      },
      "required": ["doc_id"]
    },
    "capability": "cap:fs.read",
    "reversibility": "reversible",
    "resource_type": "file",
    "resource_value": "doc://{doc_id}",
    "resource_region": "eu-west",
    "egress": "none",
    "sandbox": { "command": "read", "path_arg": "doc_id" }
  }
]
