[Unit]
Description=Drenagem da fila de planos do no AOS, 1 minuto depois da anterior (AOS-437, AOS-447)

[Timer]
OnBootSec=5min
# AOS-447: a forma do trabalhador decidida pelo dono - UM trabalhador, que volta 1 min depois de a
# drenagem anterior ACABAR (nunca duas em simultaneo: o systemd nao arranca um oneshot activo), e
# cada drenagem consome UM pedido (Environment=DRENAR_MAX=1 no .service, que muda com este). Era 5min: um pedido esperava
# ate 5 min para comecar. Reinstalar exige root (deploy/server/README.md, AOS-447).
OnUnitInactiveSec=1min
AccuracySec=5s

[Install]
WantedBy=timers.target
