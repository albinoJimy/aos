[Unit]
Description=Drena a fila de pedidos de plano do no AOS sem operador (AOS-437)
Documentation=file:///opt/aos/README.md
After=docker.service aos-cunhar-nhi.service
Requires=docker.service

[Service]
Type=oneshot
User=aos
Group=aos
ExecStart=/opt/aos/drenar-planos.sh
# Um plano pode durar ate --plan-timeout (40 min por omissao) e o consume drena ate 4. O systemd
# nunca arranca um segundo oneshot enquanto este esta activo: nao ha drenagens sobrepostas.
TimeoutStartSec=3h
