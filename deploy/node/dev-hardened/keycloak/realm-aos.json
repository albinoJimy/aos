{
  "realm": "aos",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername(undefined)",
  "clients": [
    {
      "clientId": "litellm",
      "enabled": true,
      "publicClient": false,
      "secret": "litellm-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4000/sso/callback", "http://localhost:4000/*"],
      "webOrigins": ["http://localhost:4000"]
    },
    {
      "clientId": "aos-node",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "board-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "board",
            "claim.value": "board:demo",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "aud-aos-node",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "aos-node",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Reader",
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ],
      "requiredActions": [],
      "realmRoles": ["default-roles-aos"]
    }
  ]
}
